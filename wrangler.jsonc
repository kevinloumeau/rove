{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rove",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rove",
      // Replace with the ID from `wrangler d1 create rove` (or the Cloudflare dashboard).
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rove-closet" }],
  "vars": {
    // Cloudflare Access protects the app. Fill these in from Zero Trust > Access > Applications:
    // the team domain (e.g. "yourteam.cloudflareaccess.com") and the application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
}
