{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rove",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rove",
      "database_id": "e570b77a-a430-42fe-8a56-c1836680c21b",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rove-closet" }],
  // Workers AI for studio photos. Free up to 10,000 neurons a day (about six photos).
  "ai": { "binding": "AI" },
  // Nightly cleanup of imports that were never confirmed (worker/index.ts, scheduled).
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    // Cloudflare Access protects the app. Fill these in from Zero Trust > Access > Applications:
    // the team domain (e.g. "yourteam.cloudflareaccess.com") and the application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "blue-mouse-2b9e.cloudflareaccess.com",
    "ACCESS_AUD": "658e4e82f9c19bc7c427cd93edcc527c9366a3c88bcbf63422544c635ee703ce",
  },
  // Worker Previews: every branch build runs `wrangler preview`, which never inherits the settings above.
  // Point previews at the preview database and bucket, so a branch can't touch the real closet.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "rove-preview",
        "database_id": "d650197a-30f4-4bb2-ac84-9821240087b8",
        "migrations_dir": "drizzle",
      },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rove-closet-preview" }],
    "vars": {
      "ACCESS_TEAM_DOMAIN": "blue-mouse-2b9e.cloudflareaccess.com",
      "ACCESS_AUD": "658e4e82f9c19bc7c427cd93edcc527c9366a3c88bcbf63422544c635ee703ce",
    },
  },
  "env": {
    // A separate Worker (rove-preview) with its own database and bucket, so trying a branch never
    // touches the real closet. Deploy with `npm run deploy:preview`; see README.
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rove-preview",
          "database_id": "d650197a-30f4-4bb2-ac84-9821240087b8",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rove-closet-preview" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [] },
      "vars": {
        // Protect rove-preview's workers.dev route with the same Access application, so this AUD matches.
        "ACCESS_TEAM_DOMAIN": "blue-mouse-2b9e.cloudflareaccess.com",
        "ACCESS_AUD": "658e4e82f9c19bc7c427cd93edcc527c9366a3c88bcbf63422544c635ee703ce",
      },
    },
  },
}
